# --- Midasbuy (login via "Sign in/up with other ways") ---
MIDAS_URL=https://www.midasbuy.com/midasbuy/jp/shop/aoem?from=self_midasbuy_saas#/pages/shop/items
MIDAS_EMAIL=your-email@example.com
MIDAS_PASSWORD=your-midasbuy-password

# --- Target (from the test sheet) ---
PLAYER_UID=your-player-uid
PACK_PRICE_JPY=146

# --- MyBitCash (only needed for the real payment, not for dry-run) ---
BITCASH_ID=your-bitcash-id
BITCASH_PASSWORD=your-bitcash-password

# --- Runtime ---
# chrome = use installed Google Chrome (recommended, fewer bot flags). Empty = bundled Chromium.
CHROME_CHANNEL=chrome
PROFILE_DIR=.profile
ARTIFACTS_DIR=artifacts
SLOW_MO=80
# If an automated step fails, pause and let you finish it by hand, then continue.
MANUAL_ASSIST=true
